# Copy to .env. Never commit real credentials.
# Network feeds and optional Redis are disabled unless explicitly enabled.
LIVE_FETCH_ENABLED=0
CRICAPI_KEY=
RAPIDAPI_KEY=
REDIS_URL=
CORS_ORIGINS=https://criclytics.aliamirchoudhary.workers.dev

# Public browser API origin: empty = same-origin Flask; HTTPS origin for static hosting.
FRONTEND_API_BASE=

# Recommended immutable private dataset store; validates current.json at startup.
# Empty leaves historical data unselected unless explicitly configured below.
DATASET_STORE=
# Explicit private candidate/fixture directory (no cross-generation fallbacks).
PROCESSED_DIR=
# Local legacy archive inspection only; known statistics defects remain.
LEGACY_DATA_ENABLED=0

# Optional dataset-bound identity JSON generated offline; no remote fetching at startup.
IDENTITY_REGISTRY=
